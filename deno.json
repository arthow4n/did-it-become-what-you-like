{
  "$schema": "https://json.schemastore.org/deno.json",
  "nodeModulesDir": "auto",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "imports": {
    "@google/genai": "npm:@google/genai@2.19.0",
    "@openrouter/sdk": "npm:@openrouter/sdk@1.2.82",
    "@mantine/core": "npm:@mantine/core@9.5.0",
    "@mantine/dates": "npm:@mantine/dates@9.5.0",
    "@mantine/dropzone": "npm:@mantine/dropzone@9.5.0",
    "@mantine/hooks": "npm:@mantine/hooks@9.5.0",
    "@mantine/notifications": "npm:@mantine/notifications@9.5.0",
    "react": "npm:react@19.2.8",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.4",
    "@types/big.js": "npm:@types/big.js@7.0.0",
    "xstate": "npm:xstate@5.32.5",
    "@xstate/react": "npm:@xstate/react@6.1.0",
    "lucide-react": "npm:lucide-react@1.33.0",
    "zod": "npm:zod@4.4.3",
    "big.js": "npm:big.js@7.0.1",
    "@automerge/automerge": "npm:@automerge/automerge@3.4.1",
    "fake-indexeddb": "npm:fake-indexeddb@6.2.4",
    "vite": "npm:vite@8.2.2",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.0",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@1.3.0",
    "@playwright/test": "npm:@playwright/test@1.62.1",
    "@testing-library/react": "npm:@testing-library/react@16.3.2",
    "@testing-library/dom": "npm:@testing-library/dom@10.4.1",
    "axe-core": "npm:axe-core@4.11.0",
    "happy-dom": "npm:happy-dom@20.11.6"
  },
  "tasks": {
    "dev": "deno run -A npm:vite@8.2.2 --host 127.0.0.1",
    "fmt:check": "deno fmt --check deno.json tsconfig.app.json vite.config.ts vite.gallery.config.ts index.html src scripts e2e",
    "lint": "deno lint src scripts e2e vite.config.ts vite.gallery.config.ts",
    "typecheck": "deno run -A npm:typescript@7.0.2/tsc --noEmit --project tsconfig.app.json && deno check --config deno.json scripts/*.ts scripts/**/*.ts e2e/*.ts e2e/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env src scripts/tests",
    "test:affected": "deno test --allow-read --allow-write --allow-run --allow-env --changed",
    "build": "deno run -A npm:vite@8.2.2 build --config vite.config.ts",
    "verify": "deno task fmt:check && deno task lint && deno task typecheck && deno task test && deno task build && deno task release:verify && deno audit --frozen",
    "browser:install": "deno run -A scripts/install-browsers.ts",
    "test:e2e": "deno x -p npm:@playwright/test@1.62.1 playwright test --config=e2e/playwright.config.ts",
    "audit:capture": "deno run -A scripts/audit-capture.ts",
    "gallery:build": "deno run -A npm:vite@8.2.2 build --config vite.gallery.config.ts",
    "gallery:verify": "deno run -A scripts/verify-gallery.ts",
    "release:verify": "deno run -A scripts/verify-release.ts"
  }
}
