{
  "$schema": "https://json.schemastore.org/deno.json",
  "nodeModulesDir": "auto",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "imports": {
    "react": "npm:react@19.2.8",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.4",
    "@types/big.js": "npm:@types/big.js@7.0.0",
    "xstate": "npm:xstate@5.32.5",
    "@xstate/react": "npm:@xstate/react@6.1.0",
    "react-aria-components": "npm:react-aria-components@1.20.0",
    "lucide-react": "npm:lucide-react@1.33.0",
    "zod": "npm:zod@4.4.3",
    "big.js": "npm:big.js@7.0.1",
    "vite": "npm:vite@8.2.2",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.0",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@1.3.0",
    "@playwright/test": "npm:@playwright/test@1.62.1",
    "@testing-library/react": "npm:@testing-library/react@16.3.2",
    "@testing-library/dom": "npm:@testing-library/dom@10.4.1",
    "happy-dom": "npm:happy-dom@20.11.6"
  },
  "tasks": {
    "fmt:check": "deno fmt --check deno.json spikes/toolchain",
    "lint": "deno lint spikes/toolchain",
    "check": "deno run -A npm:typescript@7.0.2/tsc --noEmit --project spikes/toolchain/tsconfig.json",
    "test": "deno test --allow-read --allow-env spikes/toolchain/tests",
    "build": "deno run -A npm:vite@8.2.2 build --config spikes/toolchain/vite.config.ts",
    "browser:install": "deno x -p npm:@playwright/test@1.62.1 playwright install chromium",
    "test:e2e": "deno x -p npm:@playwright/test@1.62.1 playwright test --config=spikes/toolchain/playwright.config.ts",
    "verify:toolchain": "deno run -A spikes/toolchain/verify.ts"
  }
}
