{
  "name": "did-it-become-what-you-like",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify && wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview",
    "worker:dev": "wrangler dev",
    "pages:build": "vite build --config vite.config.ts",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint src scripts e2e server vite.config.ts vite.gallery.config.ts",
    "worker:types": "node -e \"require('node:fs').mkdirSync('.cloudflare/types', { recursive: true })\" && wrangler types .cloudflare/types/index.d.ts",
    "typecheck": "npm run worker:types && tsc --noEmit",
    "test": "vitest run",
    "test:affected": "vitest run --changed HEAD",
    "verify": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run pages:build && npm run release:verify && npm run audit",
    "browser:install": "node --use-env-proxy scripts/install-browsers.ts && playwright install chromium",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "audit:capture": "node scripts/audit-capture.ts",
    "gallery:build": "vite build --config vite.gallery.config.ts",
    "gallery:verify": "node --use-env-proxy scripts/verify-gallery.ts",
    "release:verify": "node scripts/verify-release.ts",
    "audit": "node --use-env-proxy scripts/audit-dependencies.ts"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@google/genai": "2.27.0",
    "@mantine/core": "9.5.0",
    "@mantine/dates": "9.5.0",
    "@mantine/dropzone": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@mantine/notifications": "9.5.0",
    "@openrouter/sdk": "1.2.82",
    "@xstate/react": "6.1.0",
    "big.js": "7.0.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@dprint/json": "0.21.3",
    "@dprint/typescript": "0.96.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dprint": "0.65.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "miniflare": "5.20261117.0-beta",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
