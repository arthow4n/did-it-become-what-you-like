{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "did-it-become-what-you-like",
  "account_id": "cfc930f5a1c44ec8df3c0e8819e7b9d0",
  "main": "server/main.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "vars": {
    "FRONTEND_URL": "https://arthow4n.github.io/did-it-become-what-you-like/",
    "SERVER_ORIGIN": "https://did-it-become-what-you-like.arthow4n.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "did-it-become-what-you-like",
      "database_id": "44dbb75e-7190-4934-9c16-de0123f5d73e",
      "migrations_dir": "server/migrations",
    },
  ],
  "triggers": { "crons": ["19 3 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "previews": {
    "vars": {
      "FRONTEND_URL": "https://arthow4n.github.io/did-it-become-what-you-like/",
      "SERVER_ORIGIN": "",
    },
  },
}
